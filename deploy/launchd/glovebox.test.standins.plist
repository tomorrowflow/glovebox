<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The test stand-ins (ADR 0007), a system LaunchDaemon that runs as glovebox-test.
  Same contract as glovebox.test.gate.plist: `env.py serve standins` keeps the
  stand-in listeners alive while `env.py up` wants them. They are HTTP fixtures,
  including the iMessage one, so they need no GUI login and no Messages.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>glovebox.test.standins</string>
  <key>UserName</key>
  <string>@USER@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@REPO@/scripts/env.py</string>
    <string>serve</string>
    <string>standins</string>
    <string>--tier</string>
    <string>test</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>GLOVEBOX_ENV_TIER</key>
    <string>test</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>@LOGS@/standins.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/standins.log</string>
</dict>
</plist>
