FROM python:3.12-slim

WORKDIR /app
COPY constraints.txt pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir -c constraints.txt .

# The database directory, owned by the gate's user so a named volume mounted
# here starts out writable by it.
RUN mkdir /data && chown 10001:10001 /data

USER 10001:10001
EXPOSE 8765
CMD ["glovebox"]
